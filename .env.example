# --- Required ---------------------------------------------------------------

# Resend API key. Create at https://resend.com/api-keys
# If you have an existing Resend account with other projects, create a
# DOMAIN-SCOPED key (Sending access -> only the agent's domain) so a leaked
# key cannot send from your other domains.
RESEND_API_KEY=re_xxxxxxxxx

# Webhook signing secret. Returned as `signing_secret` when you create the
# webhook (npm run register-webhook), or copy it from the Resend dashboard.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# --- Security configuration ---------------------------------------------------

# strict   = only ALLOWED_SENDERS may reach the agent (recommended)
# domain   = anyone at ALLOWED_DOMAINS may reach the agent
# filtered = accept from anyone, reject emails matching unsafe patterns
SECURITY_LEVEL=strict

# Comma-separated exact sender addresses (used by SECURITY_LEVEL=strict)
ALLOWED_SENDERS=k.rupniewski@ekoprime.pl

# Comma-separated sender domains (used by SECURITY_LEVEL=domain)
ALLOWED_DOMAINS=ekoprime.pl

# Where security notifications about rejected emails are sent
OWNER_EMAIL=k.rupniewski@ekoprime.pl

# --- Sending ------------------------------------------------------------------

# The From address for agent replies. Must be on a verified Resend domain.
AGENT_FROM="Agent <agent@example.com>"

# --- Server -------------------------------------------------------------------

PORT=3000

# Public HTTPS URL of this server (used by scripts/register-webhook.js),
# e.g. your Tailscale Funnel or ngrok URL, or the production deployment URL.
PUBLIC_URL=https://your-tunnel-or-deployment.example.com
